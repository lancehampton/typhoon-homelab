# Network Configuration
DESKTOP_IP=192.168.50.100          # IP address of your desktop PC
DOCKER_SUBNET=172.20.0.0/16        # Docker internal network
DHCP_RANGE=192.168.50.1,proxy,255.255.255.0  # Proxy DHCP range for dnsmasq

# Matchbox Configuration
MATCHBOX_HTTP_ENDPOINT=http://192.168.50.100:8080
MATCHBOX_RPC_ENDPOINT=192.168.50.100:8081

# Target Node Configuration
TARGET_NODE_IP=192.168.50.200      # IP for your single target node (static assignment)
TARGET_NODE_MAC=C4:65:16:B9:35:DC   # MAC address of target node
TARGET_NODE_HOSTNAME=node1          # Hostname for target node
TARGET_NODE_DOMAIN=node1.home       # Match your ASUS router domain

# Cluster Configuration
CLUSTER_NAME=homelab
K8S_DOMAIN=node1.home               # Match your ASUS router domain

# Fedora CoreOS
FCOS_STREAM=stable
FCOS_VERSION=42.20250705.3.0
